# Application environment: development, test, or production
PP_AI_ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
PP_AI_LOG_LEVEL=INFO

# Keep this as mock until Module 3.
# Supported future values: mock, openai, gemini
PP_AI_LLM_PROVIDER=mock
PP_AI_LLM_MODEL=mock-planner-v1

# Maximum permitted external-provider request duration, in seconds
PP_AI_REQUEST_TIMEOUT_SECONDS=30

# Never put a real secret in this example file.
# Add it only to your local, ignored .env file:
# PP_AI_LLM_API_KEY=